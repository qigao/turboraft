<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>TurboRaft.Native</PackageId>
    <Authors>qigao</Authors>
    <Description>TurboRaft 0.3 native C SDK for release-qualified Linux x64 and Windows x64 builds.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/qigao/turboraft</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/qigao/turboraft</PackageProjectUrl>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Salts.Native" Version="*" PrivateAssets="all" />
    <PackageReference Include="SaltsUtils.Native" Version="*" PrivateAssets="all" />
    <PackageReference Include="FlowMQ.Native" Version="*" PrivateAssets="all" />
    <PackageReference Include="CHttp.Native" Version="*" PrivateAssets="all" />
    <PackageReference Include="TurboDB.Native" Version="[2.3.1]" PrivateAssets="all"
                      Condition="'$(TurboRaftRestoreOrm)' == 'true'" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(PackageRoot)/sdk/**/*" Pack="true" PackagePath="sdk/" />
  </ItemGroup>
</Project>
