{
  "version": 6,
  "include": [
    "../tests/package/CMakeUserPresets.json"
  ],
  "configurePresets": [
    {
      "name": "benchmark-linux-user",
      "inherits": "package-linux-user",
      "binaryDir": "${sourceDir}/build/benchmark",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "benchmark-linux-user",
      "configurePreset": "benchmark-linux-user"
    }
  ],
  "testPresets": [
    {
      "name": "benchmark-linux-user",
      "configurePreset": "benchmark-linux-user",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 600
      }
    }
  ]
}
