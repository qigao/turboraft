schema TurboRaftNode [id(8104), version(1)];

message RaftNodePeer {
    uint64 node_id;
    bool tls_require_client_certificate default true;
    string identity;
    string endpoint;
    list<string> client_certificate_sha256;
    optional string tls_ca_file;
    optional string tls_cert_file;
    optional string tls_key_file;
    optional string tls_server_name;
}

message RaftNodeOwner {
    bool tls_require_client_certificate default true;
    string bind_endpoint;
    string identity;
    list<RaftNodePeer> peers;
    optional string tls_ca_file;
    optional string tls_cert_file;
    optional string tls_key_file;
    optional string tls_server_name;
}

message RaftNodeGroup {
    uint64 group_id;
    uint32 owner_index;
    uint32 heartbeat_ticks default 1;
    uint32 election_min_ticks default 10;
    uint32 election_max_ticks default 20;
    uint32 max_log_entries default 1024;
    list<uint64> voters;
    list<uint64> learners;
    string storage_path;
}

message RaftNodeConfig {
    uint32 version;
    uint64 node_id;
    uuid cluster_id;
    uint64 config_epoch default 1;
    uint32 owner_count default 1;
    uint32 capacity default 64;
    uint32 work_budget default 8;
    uint32 tick_ms default 100;
    uint32 idle_ms default 1;
    bool network_enabled default false;
    uint32 network_batch default 16;
    uint32 network_queue_items default 256;
    uint32 network_queue_bytes default 4194304;
    uint32 reconnect_initial_ms default 10;
    uint32 reconnect_max_ms default 1000;
    uint32 heartbeat_interval_ms default 1000;
    uint32 heartbeat_timeout_ms default 5000;
    list<RaftNodeOwner> owners;
    list<RaftNodeGroup> groups;
}
