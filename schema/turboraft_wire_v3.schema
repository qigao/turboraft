schema TurboRaftWireV3 [id(8102), version(3), byte_order(little)];

message RaftWireMessageV3 {
    uint8 message_type;
    uint8 granted;
    uint16 reserved;
    uint32 entry_count;
    uint64 from_node;
    uint64 to_node;
    uint64 term;
    uint64 campaign_term;
    uint64 last_log_index;
    uint64 last_log_term;
    uint64 leader_commit;
    uint64 previous_log_index;
    uint64 previous_log_term;
    uint64 match_index;
    uint64 reject_hint;
    uint64 entry1_index;
    uint64 entry1_term;
    uint64 entry1_command_id;
    uint64 entry2_index;
    uint64 entry2_term;
    uint64 entry2_command_id;
    uint64 entry3_index;
    uint64 entry3_term;
    uint64 entry3_command_id;
    uint64 entry4_index;
    uint64 entry4_term;
    uint64 entry4_command_id;
    uint64 entry5_index;
    uint64 entry5_term;
    uint64 entry5_command_id;
    uint64 entry6_index;
    uint64 entry6_term;
    uint64 entry6_command_id;
    uint64 entry7_index;
    uint64 entry7_term;
    uint64 entry7_command_id;
    uint64 entry8_index;
    uint64 entry8_term;
    uint64 entry8_command_id;
    bytes entry1_data;
    bytes entry2_data;
    bytes entry3_data;
    bytes entry4_data;
    bytes entry5_data;
    bytes entry6_data;
    bytes entry7_data;
    bytes entry8_data;
}
