        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/stage/sdk/windows-x64"
      }
    },
    {
      "name": "ci-linux-release-user",
      "inherits": "native-sdk-linux-user",
      "binaryDir": "${sourceDir}/.ci/build/turboraft",
      "cacheVariables": {
        "TURBORAFT_BUILD_PROFILE": "full",
        "BUILD_TESTING": true,
        "BUILD_TESTS": true
      },
      "environment": {
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{FLOWMQ_ROOT}/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/.ci/build/turboraft/bin${pathListSep}$env{FLOWMQ_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "win-storage-user",
      "inherits": "win-release-user",
      "description": "Release storage-dev libraries without FlowMQ or host parser tools",
      "binaryDir": "${sourceDir}/build/Msvc-Storage",
      "cacheVariables": {
        "TURBORAFT_BUILD_PROFILE": "storage-dev",
        "BUILD_TESTING": false,
        "BUILD_TESTS": false,
        "BUILD_BENCHMARKS": false,
        "BUILD_EXAMPLES": false,
        "TURBORAFT_BUILD_FUZZERS": false,
        "TURBORAFT_ENABLE_ORM_SQLITE_FIXTURES": false,
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboraft-storage/release"
      }
    },
    {
      "name": "win-benchmarks-user",
      "inherits": "win-release-user",
      "binaryDir": "${sourceDir}/build/Msvc-Benchmarks",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "BUILD_TESTS": false,
        "BUILD_BENCHMARKS": true,
        "BUILD_EXAMPLES": true
      }
    },
    {
      "name": "linux-benchmarks-user",
      "inherits": "linux-release-user",
      "binaryDir": "${sourceDir}/build/Linux-Benchmarks",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "BUILD_TESTS": false,
        "BUILD_BENCHMARKS": true,
        "BUILD_EXAMPLES": true
      }
    },
    {
      "name": "win-orm-user",
      "inherits": "win-release-user",
      "binaryDir": "${sourceDir}/build/Msvc-Orm",
      "cacheVariables": {
        "TURBORAFT_ENABLE_ORM_SQLITE_FIXTURES": true,
        "TURBORAFT_ENABLE_ORM_LIVE_TESTS": false,
        "BUILD_TESTING": true,
        "BUILD_TESTS": true,
        "BUILD_EXAMPLES": false,
        "BUILD_BENCHMARKS": false
      }
    },
    {
      "name": "ci-linux-orm-user",
      "inherits": "ci-linux-release-user",
      "binaryDir": "${sourceDir}/.ci/build/turboraft-orm",
      "cacheVariables": {
        "TURBORAFT_ENABLE_ORM_SQLITE_FIXTURES": true,
        "TURBORAFT_ENABLE_ORM_LIVE_TESTS": true,
        "BUILD_TESTING": true,
        "BUILD_TESTS": true,
        "BUILD_EXAMPLES": false,
        "BUILD_BENCHMARKS": false
      }
    }
