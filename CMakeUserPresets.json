{
  "version": 6,
  "include": ["CMakePresets.json"],
  "configurePresets": [
    {
      "name": "win-toolchain",
      "hidden": true,
      "environment": {
        "PROJECT_ROOT": "C:/projects/cpp",
        "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
        "VCPKG_ROOT": "C:/tools/vcpkg",
        "USER_ROOT": "C:/Users/lockg",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      }
    },
    {
      "name": "win-paths",
      "hidden": true,
      "inherits": "win-toolchain",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "ON"
      },
      "architecture": {"value": "x64", "strategy": "external"},
      "toolset": {"value": "host=x64", "strategy": "external"}
    },
    {
      "name": "linux-paths",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_MANIFEST_MODE": "ON"
      },
      "environment": {
        "PKG_ROOT": "/opt",
        "VCPKG_ROOT": "/opt/vcpkg",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      }
    },
    {
      "name": "android-win-environment",
      "hidden": true,
      "inherits": "win-toolchain",
      "environment": {
        "ANDROID_SDK_ROOT": "$env{USER_ROOT}/AppData/Local/Android/Sdk",
        "ANDROID_NDK_VERSION": "28.2.13676358",
        "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
      }
    },
    {
      "name": "android-win-paths",
      "hidden": true,
      "inherits": "ISWindows",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}"
      }
    },
    {
      "name": "win-dev-user",
      "inherits": ["base-win-dev-user", "win-paths"],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
        "FLOWMQ_ROOT": "$env{PKG_ROOT}/flowmq/debug",
        "TURBODB_ROOT": "$env{PKG_ROOT}/turbodb/debug",
        "PATH": "${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{FLOWMQ_ROOT}/bin${pathListSep}$env{TURBODB_ROOT}/bin${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboraft/debug"
      }
    },
    {
      "name": "win-release-user",
      "inherits": ["base-win-release-user", "win-paths"],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
        "FLOWMQ_ROOT": "$env{PKG_ROOT}/flowmq/release",
        "TURBODB_ROOT": "$env{PKG_ROOT}/turbodb/release",
        "PATH": "${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{FLOWMQ_ROOT}/bin${pathListSep}$env{TURBODB_ROOT}/bin${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "TURBORAFT_ENABLE_TURBODB_REDIS_STATE_MACHINE": "ON",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboraft/release"
      }
    },
    {
      "name": "linux-dev-user",
      "inherits": ["base-linux-dev-user", "linux-paths"],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
        "FLOWMQ_ROOT": "$env{PKG_ROOT}/flowmq/debug",
        "TURBODB_ROOT": "$env{PKG_ROOT}/turbodb/debug",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{FLOWMQ_ROOT}/lib${pathListSep}$env{TURBODB_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboraft/debug"
      }
    },
    {
      "name": "linux-release-user",
      "inherits": ["release-linux-ninja", "linux-paths"],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
        "FLOWMQ_ROOT": "$env{PKG_ROOT}/flowmq/release",
        "TURBODB_ROOT": "$env{PKG_ROOT}/turbodb/release",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{FLOWMQ_ROOT}/lib${pathListSep}$env{TURBODB_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboraft/release"
      }
    },
    {
      "name": "win-analyze-user",
      "inherits": ["win-dev-user"],
      "binaryDir": "${sourceDir}/build/Msvc-Analyze",
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "OFF",
        "ENABLE_MSVC_ANALYZE": "ON"
      }
    },
    {
      "name": "linux-ubsan-user",
      "inherits": ["linux-dev-user"],
      "binaryDir": "${sourceDir}/build/Linux-UBSan",
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "OFF",
        "ENABLE_SANITIZER_UNDEFINED": "ON"
      }
    },
    {
      "name": "linux-tsan-user",
      "inherits": ["linux-dev-user"],
      "binaryDir": "${sourceDir}/build/Linux-TSan",
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "OFF",
        "ENABLE_SANITIZER_THREAD": "ON"
      }
    },
    {
      "name": "android-dependencies-debug",
      "hidden": true,
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/debug",
        "SALTS_UTILS_HOST_ROOT": "$env{PKG_ROOT}/salts-utils/release",
        "FLOWMQ_ROOT": "$env{PKG_ROOT}/flowmq-android/debug"
      },
      "cacheVariables": {"CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboraft-android/debug"}
    },
    {
      "name": "android-dependencies-release",
      "hidden": true,
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/release",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/release",
        "SALTS_UTILS_HOST_ROOT": "$env{PKG_ROOT}/salts-utils/release",
        "FLOWMQ_ROOT": "$env{PKG_ROOT}/flowmq-android/release"
      },
      "cacheVariables": {"CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboraft-android/release"}
    },
    {"name": "android-arm64-v8a-debug-win", "inherits": ["android-arm64-v8a-debug", "android-dependencies-debug", "android-win-paths", "android-win-environment"]},
    {"name": "android-arm64-v8a-release-win", "inherits": ["android-arm64-v8a-release", "android-dependencies-release", "android-win-paths", "android-win-environment"]},
    {"name": "android-x86_64-debug-win", "inherits": ["android-x86_64-debug", "android-dependencies-debug", "android-win-paths", "android-win-environment"]},
    {"name": "android-x86_64-release-win", "inherits": ["android-x86_64-release", "android-dependencies-release", "android-win-paths", "android-win-environment"]},
    {"name": "android-x86-debug-win", "inherits": ["android-x86-debug", "android-dependencies-debug", "android-win-paths", "android-win-environment"]},
    {"name": "android-x86-release-win", "inherits": ["android-x86-release", "android-dependencies-release", "android-win-paths", "android-win-environment"]}
  ],
  "buildPresets": [
    {"name": "win-dev-user", "configurePreset": "win-dev-user"},
    {"name": "win-release-user", "configurePreset": "win-release-user"},
    {"name": "win-analyze-user", "configurePreset": "win-analyze-user"},
    {"name": "linux-dev-user", "configurePreset": "linux-dev-user"},
    {"name": "linux-release-user", "configurePreset": "linux-release-user"},
    {"name": "linux-ubsan-user", "configurePreset": "linux-ubsan-user"},
    {"name": "linux-tsan-user", "configurePreset": "linux-tsan-user"},
    {"name": "install-win-dev-user", "configurePreset": "win-dev-user", "targets": ["install"]},
    {"name": "install-win-release-user", "configurePreset": "win-release-user", "targets": ["install"]},
    {"name": "install-linux-dev-user", "configurePreset": "linux-dev-user", "targets": ["install"]},
    {"name": "install-linux-release-user", "configurePreset": "linux-release-user", "targets": ["install"]},
    {"name": "android-arm64-v8a-debug-win", "configurePreset": "android-arm64-v8a-debug-win"},
    {"name": "android-arm64-v8a-release-win", "configurePreset": "android-arm64-v8a-release-win"},
    {"name": "android-x86_64-debug-win", "configurePreset": "android-x86_64-debug-win"},
    {"name": "android-x86_64-release-win", "configurePreset": "android-x86_64-release-win"},
    {"name": "android-x86-debug-win", "configurePreset": "android-x86-debug-win"},
    {"name": "android-x86-release-win", "configurePreset": "android-x86-release-win"},
    {"name": "install-android-arm64-v8a-debug-win", "configurePreset": "android-arm64-v8a-debug-win", "targets": ["install"]},
    {"name": "install-android-arm64-v8a-release-win", "configurePreset": "android-arm64-v8a-release-win", "targets": ["install"]},
    {"name": "install-android-x86_64-debug-win", "configurePreset": "android-x86_64-debug-win", "targets": ["install"]},
    {"name": "install-android-x86_64-release-win", "configurePreset": "android-x86_64-release-win", "targets": ["install"]},
    {"name": "install-android-x86-debug-win", "configurePreset": "android-x86-debug-win", "targets": ["install"]},
    {"name": "install-android-x86-release-win", "configurePreset": "android-x86-release-win", "targets": ["install"]}
  ],
  "testPresets": [
    {"name": "win-dev-user", "inherits": "base-test", "configurePreset": "win-dev-user"},
    {"name": "win-release-user", "inherits": "base-test", "configurePreset": "win-release-user"},
    {"name": "win-analyze-user", "inherits": "base-test", "configurePreset": "win-analyze-user"},
    {"name": "linux-dev-user", "inherits": "base-test", "configurePreset": "linux-dev-user"},
    {"name": "linux-release-user", "inherits": "base-test", "configurePreset": "linux-release-user"},
    {"name": "linux-ubsan-user", "inherits": "base-test", "configurePreset": "linux-ubsan-user"},
    {"name": "linux-tsan-user", "inherits": "base-test", "configurePreset": "linux-tsan-user"}
  ]
}
