    {
      "name": "native-sdk-ci",
      "hidden": true,
      "inherits": "vcpkg-cache-ci",
      "binaryDir": "${sourceDir}/build/native-sdk",
      "environment": {
        "VCPKG_ROOT": "$penv{VCPKG_ROOT}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "FLOWMQ_ROOT": "$penv{FLOWMQ_ROOT}",
        "CHTTP_ROOT": "$penv{CHTTP_ROOT}",
        "TURBODB_ROOT": "$penv{TURBODB_ROOT}"
      },
      "cacheVariables": {
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_INSTALL_OPTIONS": "--only-binarycaching",
        "BUILD_TESTING": false,
        "BUILD_TESTS": false,
        "BUILD_BENCHMARKS": false,
        "BUILD_EXAMPLES": false,
        "TURBORAFT_ENABLE_ORM_SQLITE_FIXTURES": false,
        "TURBORAFT_ENABLE_ORM_LIVE_TESTS": false
      }
    },
    {
      "name": "native-sdk-linux-user",
      "inherits": [
        "native-sdk-ci",
        "release-linux-ninja"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/stage/sdk/linux-x64"
      }
    },
    {
      "name": "native-sdk-windows-user",
      "inherits": [
