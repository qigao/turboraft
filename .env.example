# Merge these non-secret fields into .env; preserve existing credentials.
# Load .env in the parent process before CMake; values are literal.
VCPKG_CACHE_VERSION=0.1.3
VCPKG_CACHE_REPOSITORY_ROOT=C:/projects/cpp/turbonet/vcpkg-cache
# Replace these example roots with the roots returned by vcpkg-cache locked restore.
VCPKG_TARGET_TRIPLET=qigao-x64-windows-llvm-mingw
QIGAO_HOST_RID=windows-x64
VCPKG_INSTALLED_DIR=C:/sdk/vcpkg-cache-0.1.3-qigao-x64-windows-llvm-mingw-<digest>/payload/vcpkg_installed
RE2C_ROOT=C:/sdk/Qigao.Re2c.Binary-4.6.7-windows-x64-<digest>/payload/tools/windows-x64
LEMON_ROOT=C:/sdk/Qigao.Lemon.Binary-1.0.0-windows-x64-<digest>/payload/tools/windows-x64

# These roots supply runtime DLL paths for the selected packages.
CHTTP_VERSION=0.1.2
CHTTP_ROOT=C:/sdk/chttp-0.1.2-windows-llvm-mingw-x64
TURBODB_ROOT=C:/sdk/turbodb-0.1.2-windows-llvm-mingw-x64
SALTS_BASE_VERSION=0.1.8
SALTS_BASE_ROOT=C:/sdk/salts-base-0.1.8-windows-llvm-mingw-x64
CMETA_VERSION=0.1.8
CMETA_ROOT=C:/sdk/cmeta-0.1.8-windows-llvm-mingw-x64
SALTS_CNET_VERSION=0.1.16
SALTS_CNET_ROOT=C:/sdk/salts-cnet-0.1.16-windows-llvm-mingw-x64
SALTS_UTILS_VERSION=0.1.6
SALTS_UTILS_ROOT=C:/sdk/salts-utils-0.1.6-windows-llvm-mingw-x64
LLVM_MINGW_ROOT=C:/tools/llvm-mingw
VSDEVCMD_BAT=C:/Program Files/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat
CMAKE_BUILD_PARALLEL_LEVEL=3
# Native formal tests require an independent OpenSSL 3 command-line tool.
CHTTP_TEST_OPENSSL=C:/Program Files/Git/usr/bin/openssl.exe
# If required by that installation, also set OPENSSL_CONF to its openssl.cnf.
