@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(TurboUtils CONFIG)

set(_turboraft_need_openssl FALSE)
set(_turboraft_need_sqlite FALSE)
set(_turboraft_need_coronet FALSE)
set(_turboraft_need_http FALSE)

if(NOT TurboRaft_FIND_COMPONENTS)
    set(_turboraft_need_openssl TRUE)
    if("@TURBORAFT_BUILD_SQLITE_STORAGE@" STREQUAL "ON")
        set(_turboraft_need_sqlite TRUE)
    endif()
    if("@TURBORAFT_HAVE_CORONET@" STREQUAL "ON")
        set(_turboraft_need_coronet TRUE)
    endif()
    if("@TURBORAFT_HAVE_CONTROL_PLANE@" STREQUAL "ON")
        set(_turboraft_need_coronet TRUE)
        set(_turboraft_need_http TRUE)
    endif()
else()
    foreach(_turboraft_component IN LISTS TurboRaft_FIND_COMPONENTS)
        if(_turboraft_component STREQUAL "SQLiteStorage")
            set(_turboraft_need_sqlite TRUE)
        elseif(_turboraft_component STREQUAL "SnapshotReceiver" OR
               _turboraft_component STREQUAL "SnapshotSender")
            set(_turboraft_need_openssl TRUE)
        elseif(_turboraft_component STREQUAL "CoroNet" OR
               _turboraft_component STREQUAL "SnapshotManager" OR
               _turboraft_component STREQUAL "ServiceOwner")
            set(_turboraft_need_openssl TRUE)
            set(_turboraft_need_coronet TRUE)
        elseif(_turboraft_component STREQUAL "ControlPlane")
            set(_turboraft_need_openssl TRUE)
            set(_turboraft_need_coronet TRUE)
            set(_turboraft_need_http TRUE)
        endif()
    endforeach()
endif()

if(_turboraft_need_openssl)
    find_dependency(OpenSSL)
endif()
if(_turboraft_need_sqlite)
    find_dependency(unofficial-sqlite3 CONFIG)
endif()
if(_turboraft_need_coronet)
    find_dependency(Threads)
    find_dependency(TurboNet CONFIG)
endif()
if(_turboraft_need_http)
    find_dependency(TurboHttp CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TurboRaftTargets.cmake")

foreach(_turboraft_component IN LISTS TurboRaft_FIND_COMPONENTS)
    if(TARGET TurboRaft::${_turboraft_component})
        set(TurboRaft_${_turboraft_component}_FOUND TRUE)
    else()
        set(TurboRaft_${_turboraft_component}_FOUND FALSE)
    endif()
endforeach()

unset(_turboraft_component)
unset(_turboraft_need_openssl)
unset(_turboraft_need_sqlite)
unset(_turboraft_need_coronet)
unset(_turboraft_need_http)
check_required_components(TurboRaft)
