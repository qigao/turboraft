@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT DEFINED ENV{SALTS_ROOT} OR "$ENV{SALTS_ROOT}" STREQUAL "")
    set(TurboRaft_FOUND FALSE)
    set(TurboRaft_NOT_FOUND_MESSAGE
        "SALTS_ROOT must name the installed Salts profile")
    return()
endif()
if(NOT DEFINED ENV{SALTS_UTILS_ROOT} OR "$ENV{SALTS_UTILS_ROOT}" STREQUAL "")
    set(TurboRaft_FOUND FALSE)
    set(TurboRaft_NOT_FOUND_MESSAGE
        "SALTS_UTILS_ROOT must name the installed SaltsUtils profile")
    return()
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_ROOT}" TURBORAFT_SALTS_ROOT_PATH)
file(TO_CMAKE_PATH "$ENV{SALTS_UTILS_ROOT}" TURBORAFT_SALTS_UTILS_ROOT_PATH)
find_dependency(Salts CONFIG REQUIRED PATHS "${TURBORAFT_SALTS_ROOT_PATH}"
                NO_DEFAULT_PATH)
find_dependency(SaltsUtils CONFIG REQUIRED
                PATHS "${TURBORAFT_SALTS_UTILS_ROOT_PATH}" NO_DEFAULT_PATH)

set(_turboraft_need_openssl FALSE)
set(_turboraft_need_cnet FALSE)
set(_turboraft_need_http FALSE)
set(_turboraft_need_flowmq FALSE)
set(_turboraft_need_turbodb_redis_state_machine FALSE)

if(NOT TurboRaft_FIND_COMPONENTS)
    set(_turboraft_need_openssl TRUE)
    if("@TURBORAFT_HAVE_CNET@" STREQUAL "ON")
        set(_turboraft_need_cnet TRUE)
    endif()
    if("@TURBORAFT_HAVE_CONTROL_PLANE@" STREQUAL "ON")
        set(_turboraft_need_cnet TRUE)
        set(_turboraft_need_http TRUE)
    endif()
    if("@TURBORAFT_HAVE_FLOWMQ@" STREQUAL "ON")
        set(_turboraft_need_cnet TRUE)
        set(_turboraft_need_flowmq TRUE)
    endif()
    if("@TURBORAFT_HAVE_TURBODB_REDIS_STATE_MACHINE@" STREQUAL "ON")
        set(_turboraft_need_turbodb_redis_state_machine TRUE)
    endif()
else()
    foreach(_turboraft_component IN LISTS TurboRaft_FIND_COMPONENTS)
        if(_turboraft_component STREQUAL "SnapshotReceiver" OR
               _turboraft_component STREQUAL "SnapshotSender" OR
               _turboraft_component STREQUAL "DataStream")
            set(_turboraft_need_openssl TRUE)
        elseif(_turboraft_component STREQUAL "CNet")
            set(_turboraft_need_openssl TRUE)
            set(_turboraft_need_cnet TRUE)
        elseif(_turboraft_component STREQUAL "ControlPlane")
            set(_turboraft_need_openssl TRUE)
            set(_turboraft_need_cnet TRUE)
            set(_turboraft_need_http TRUE)
        elseif(_turboraft_component STREQUAL "FlowMQ")
            set(_turboraft_need_openssl TRUE)
            set(_turboraft_need_cnet TRUE)
            set(_turboraft_need_flowmq TRUE)
        elseif(_turboraft_component STREQUAL "TurboDbRedisStateMachine" AND
               "@TURBORAFT_HAVE_TURBODB_REDIS_STATE_MACHINE@" STREQUAL "ON")
            set(_turboraft_need_turbodb_redis_state_machine TRUE)
        endif()
    endforeach()
endif()

if(_turboraft_need_openssl)
find_dependency(OpenSSL)
endif()
find_dependency(xxHash CONFIG)
if(_turboraft_need_cnet)
    # CNet is exported by Salts.
endif()
if(_turboraft_need_http)
    # CHTTP and CRPC are exported by Salts.
endif()
if(_turboraft_need_flowmq)
    if(NOT DEFINED ENV{FLOWMQ_ROOT} OR "$ENV{FLOWMQ_ROOT}" STREQUAL "")
        set(TurboRaft_FOUND FALSE)
        set(TurboRaft_NOT_FOUND_MESSAGE
            "FLOWMQ_ROOT must name the installed FlowMQ profile")
        return()
    endif()
    file(TO_CMAKE_PATH "$ENV{FLOWMQ_ROOT}" TURBORAFT_FLOWMQ_ROOT_PATH)
    find_dependency(FlowMQ 1.1.0 CONFIG REQUIRED
                    PATHS "${TURBORAFT_FLOWMQ_ROOT_PATH}" NO_DEFAULT_PATH)
endif()
if(_turboraft_need_turbodb_redis_state_machine)
    if(NOT DEFINED ENV{TURBODB_ROOT} OR "$ENV{TURBODB_ROOT}" STREQUAL "" OR
       NOT IS_DIRECTORY "$ENV{TURBODB_ROOT}")
        set(TurboRaft_FOUND FALSE)
        set(TurboRaft_NOT_FOUND_MESSAGE
            "TURBODB_ROOT must name the installed TurboDB profile")
        return()
    endif()
    file(TO_CMAKE_PATH "$ENV{TURBODB_ROOT}" TURBORAFT_TURBODB_ROOT_PATH)
    find_dependency(TurboDB CONFIG REQUIRED
                    PATHS "${TURBORAFT_TURBODB_ROOT_PATH}" NO_DEFAULT_PATH)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TurboRaftTargets.cmake")

foreach(_turboraft_component IN LISTS TurboRaft_FIND_COMPONENTS)
    if(TARGET TurboRaft::${_turboraft_component})
        set(TurboRaft_${_turboraft_component}_FOUND TRUE)
    else()
        set(TurboRaft_${_turboraft_component}_FOUND FALSE)
    endif()
endforeach()

unset(_turboraft_component)
unset(_turboraft_need_openssl)
unset(_turboraft_need_cnet)
unset(_turboraft_need_http)
unset(_turboraft_need_flowmq)
unset(_turboraft_need_turbodb_redis_state_machine)
unset(TURBORAFT_FLOWMQ_ROOT_PATH)
unset(TURBORAFT_TURBODB_ROOT_PATH)
check_required_components(TurboRaft)
