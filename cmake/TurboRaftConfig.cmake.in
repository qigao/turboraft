@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT DEFINED ENV{SALTS_ROOT} OR "$ENV{SALTS_ROOT}" STREQUAL "")
    set(TurboRaft_FOUND FALSE)
    set(TurboRaft_NOT_FOUND_MESSAGE
        "SALTS_ROOT must name the installed Salts profile")
    return()
endif()
if(NOT DEFINED ENV{SALTS_UTILS_ROOT} OR "$ENV{SALTS_UTILS_ROOT}" STREQUAL "")
    set(TurboRaft_FOUND FALSE)
    set(TurboRaft_NOT_FOUND_MESSAGE
        "SALTS_UTILS_ROOT must name the installed SaltsUtils profile because Core links Salts::DataBind")
    return()
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_ROOT}" TURBORAFT_SALTS_ROOT_PATH)
file(TO_CMAKE_PATH "$ENV{SALTS_UTILS_ROOT}" TURBORAFT_SALTS_UTILS_ROOT_PATH)
unset(Salts_DIR CACHE)
unset(Salts_DIR)
unset(SaltsUtils_DIR CACHE)
unset(SaltsUtils_DIR)
find_dependency(Salts 2.3.0 EXACT CONFIG REQUIRED
                PATHS "${TURBORAFT_SALTS_ROOT_PATH}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(SaltsUtils 4.3.0 EXACT CONFIG REQUIRED
                PATHS "${TURBORAFT_SALTS_UTILS_ROOT_PATH}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

set(_turboraft_need_xxhash FALSE)
set(_turboraft_need_cnet FALSE)
set(_turboraft_need_http FALSE)
set(_turboraft_need_flowmq FALSE)

if(NOT TurboRaft_FIND_COMPONENTS)
    set(_turboraft_need_xxhash TRUE)
    if("@TURBORAFT_HAVE_CNET@" STREQUAL "ON")
        set(_turboraft_need_cnet TRUE)
    endif()
    if("@TURBORAFT_HAVE_CONTROL_PLANE@" STREQUAL "ON")
        set(_turboraft_need_cnet TRUE)
        set(_turboraft_need_http TRUE)
    endif()
    if("@TURBORAFT_HAVE_FLOWMQ@" STREQUAL "ON")
        set(_turboraft_need_cnet TRUE)
        set(_turboraft_need_flowmq TRUE)
    endif()
else()
    foreach(_turboraft_component IN LISTS TurboRaft_FIND_COMPONENTS)
        if(_turboraft_component STREQUAL "WalStorage")
            set(_turboraft_need_xxhash TRUE)
        elseif(_turboraft_component STREQUAL "CNet")
            set(_turboraft_need_cnet TRUE)
        elseif(_turboraft_component STREQUAL "SnapshotManager")
            set(_turboraft_need_cnet TRUE)
        elseif(_turboraft_component STREQUAL "ControlPlane")
            set(_turboraft_need_cnet TRUE)
            set(_turboraft_need_http TRUE)
        elseif(_turboraft_component STREQUAL "FlowMQ" OR _turboraft_component STREQUAL "NodeConfig")
            set(_turboraft_need_cnet TRUE)
            set(_turboraft_need_flowmq TRUE)
        endif()
    endforeach()
endif()

if(_turboraft_need_xxhash)
    find_dependency(xxHash CONFIG)
endif()
if(_turboraft_need_cnet)
    # CNet is exported by Salts.
endif()
if(_turboraft_need_http)
    if(NOT DEFINED ENV{CHTTP_ROOT} OR "$ENV{CHTTP_ROOT}" STREQUAL "" OR
       NOT IS_DIRECTORY "$ENV{CHTTP_ROOT}")
        set(TurboRaft_FOUND FALSE)
        set(TurboRaft_NOT_FOUND_MESSAGE
            "CHTTP_ROOT must name the installed standalone CHttp profile")
        return()
    endif()
    file(TO_CMAKE_PATH "$ENV{CHTTP_ROOT}" TURBORAFT_CHTTP_ROOT_PATH)
    find_dependency(Chttp CONFIG REQUIRED
                    PATHS "${TURBORAFT_CHTTP_ROOT_PATH}" NO_DEFAULT_PATH)
    if(NOT TARGET CHttp::Server)
        set(TurboRaft_FOUND FALSE)
        set(TurboRaft_NOT_FOUND_MESSAGE
            "Standalone CHttp SDK must export CHttp::Server")
        return()
    endif()
endif()
if(_turboraft_need_flowmq)
    if(NOT DEFINED ENV{FLOWMQ_ROOT} OR "$ENV{FLOWMQ_ROOT}" STREQUAL "")
        set(TurboRaft_FOUND FALSE)
        set(TurboRaft_NOT_FOUND_MESSAGE
            "FLOWMQ_ROOT must name the installed FlowMQ profile")
        return()
    endif()
    file(TO_CMAKE_PATH "$ENV{FLOWMQ_ROOT}" TURBORAFT_FLOWMQ_ROOT_PATH)
    unset(FlowMQ_DIR CACHE)
    unset(FlowMQ_DIR)
    find_dependency(FlowMQ 1.3.0 EXACT CONFIG REQUIRED
                    PATHS "${TURBORAFT_FLOWMQ_ROOT_PATH}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TurboRaftTargets.cmake")

foreach(_turboraft_component IN LISTS TurboRaft_FIND_COMPONENTS)
    if(TARGET TurboRaft::${_turboraft_component})
        set(TurboRaft_${_turboraft_component}_FOUND TRUE)
    else()
        set(TurboRaft_${_turboraft_component}_FOUND FALSE)
    endif()
endforeach()

unset(_turboraft_component)
unset(_turboraft_need_xxhash)
unset(_turboraft_need_cnet)
unset(_turboraft_need_http)
unset(_turboraft_need_flowmq)
unset(TURBORAFT_FLOWMQ_ROOT_PATH)
unset(TURBORAFT_CHTTP_ROOT_PATH)
check_required_components(TurboRaft)
